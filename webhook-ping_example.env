# Copy to ~/.config/grok-bot/webhook-ping.env and chmod 600.
# Use the Grok Bot keepalive/Tailscale routine's webhook, not the catalog hook.
WEBHOOK_URL='https://your-grok-bot-webhook.example/trigger'
WEBHOOK_KEY='replace-with-your-webhook-bearer'
# Applies only to the standalone Python loop; systemd uses the timer calendar.
INTERVAL_SECONDS=60
